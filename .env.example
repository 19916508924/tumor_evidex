# app
NEXT_PUBLIC_APP_URL = "http://localhost:3000"
NEXT_PUBLIC_APP_NAME = "Evidex"
NEXT_PUBLIC_APP_DESCRIPTION = "Traceable evidence intelligence for precision oncology."
NEXT_PUBLIC_APP_LOGO = "/imgs/evidex/mark.svg"
NEXT_PUBLIC_APP_FAVICON = "/imgs/evidex/mark.svg"
NEXT_PUBLIC_APP_PREVIEW_IMAGE = "/imgs/evidex/og-preview.png"

# theme
NEXT_PUBLIC_THEME = "default"

# appearance
NEXT_PUBLIC_APPEARANCE = "light"

# database
DATABASE_PROVIDER = "postgresql"
DATABASE_URL = ""
DB_SINGLETON_ENABLED = "true"
DB_MAX_CONNECTIONS = "1"

# Evidex V0 backend
# Evidex defaults to its single-user portfolio demo. Uncomment only to restore
# administrator authentication for Ops; never point the open demo at shared data.
# EVIDEX_DEMO_MODE = "0"
# Leave empty to use the latest PUBLISHED release. Set only for an explicit
# historical reproduction or operations rollback.
EVIDEX_KNOWLEDGE_RELEASE_OVERRIDE = ""
EVIDEX_PROMPT_VERSION = "evidex-answer-v1"
EVIDEX_AI_PROVIDER = "evolink"
EVIDEX_AI_MODEL = "gpt-5.6-terra"
EVIDEX_EXTRACTION_MODEL = "gpt-5.6-terra"
EVIDEX_EVOLINK_API_KEY = ""
EVIDEX_EVOLINK_BASE_URL = "https://direct.evolink.ai/v1"
EVIDEX_INGESTION_WORKFLOW_VERSION = "single-pubmed-v3"
EVIDEX_DISCOVERY_WORKFLOW_VERSION = "pubmed-discovery-v2"
EVIDEX_EXTRACTION_AGENT_VERSION = "extraction-agent@1.0.0"
# Server-only HMAC secret for 15-minute Discovery Preview confirmation tokens.
# Generate with: openssl rand -hex 32
EVIDEX_PREVIEW_SECRET = ""
EVIDEX_QUESTION_MIN_INTERVAL_MS = "1000"
EVIDEX_FEEDBACK_MIN_INTERVAL_MS = "1000"
# Optional but recommended for NCBI identification and higher rate limits.
EVIDEX_NCBI_EMAIL = ""
EVIDEX_NCBI_API_KEY = ""
# Optional CIViC API token; anonymous access is rate-limited and supported.
EVIDEX_CIVIC_API_KEY = ""
EVIDEX_CIVIC_BASE_URL = "https://civicdb.org/api/graphql"
# Optional fallback provider
EVIDEX_OPENROUTER_API_KEY = ""
EVIDEX_OPENROUTER_BASE_URL = ""

# auth secret
# openssl rand -base64 32
AUTH_SECRET = ""
